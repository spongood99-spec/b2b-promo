              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string", "format": "uuid" },
                      "user_id": { "type": "string", "format": "uuid" },
                      "promotion_id": { "type": "string", "format": "uuid", "nullable": true },
